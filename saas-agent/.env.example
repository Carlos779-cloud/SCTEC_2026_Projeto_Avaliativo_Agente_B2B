# Copie este arquivo para .env e preencha a chave do provedor escolhido.
# Nunca coloque credenciais reais neste arquivo de exemplo.

# Chave de API Groq usada pelo modelo de linguagem.
GROQ_API_KEY=

# Identificador do modelo habilitado na conta do provedor Groq.
LLM_MODEL=openai/gpt-oss-120b

# URL base da API SaaS administrativa executada localmente.
SOLAR_API_BASE_URL=http://localhost:8002

# Número máximo de iterações permitido no fluxo do agente.
AGENT_MAX_ITERATIONS=10
